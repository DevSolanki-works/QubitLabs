# ==============================================================================
# QubitLabs Environment Configuration Template
# Copy this file to create your local environment files:
#   - Backend:  backend/.env
#   - Frontend: frontend/.env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (backend/.env)
# ------------------------------------------------------------------------------

# Google Gemini API Key (Required for Quantum Copilot explanations)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Port (Optional, defaults to 8000)
PORT=8000

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (frontend/.env.local)
# ------------------------------------------------------------------------------

# Backend API Base URL
# Development: http://localhost:8000
# Production:  https://qubitlabs-api.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Authentication & User Persistence
# Get these from Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
